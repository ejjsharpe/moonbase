{
  "packageManager": "bun@1.4.4",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "nx run-many -t typecheck",
    "lint": "oxlint . --report-unused-disable-directives",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "check:foundation": "node scripts/check-foundation.mjs",
    "lint:fix": "bun run lint --fix --ignore-pattern \"packages/ui/**\"",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "name": "moonbase",
  "devDependencies": {
    "@effect/platform-node": "4.1.0",
    "monaco-editor": "0.57.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "oxlint": "1.90.0",
    "@stylexjs/unplugin": "0.19.1",
    "nx": "24.0.2",
    "typescript": "7.0.2",
    "@moonbase/application": "workspace:*",
    "@earendil-works/pi-ai": "1.4.0",
    "oxfmt": "0.75.0",
    "@moonbase/config": "workspace:*",
    "electron-builder": "26.18.0",
    "@playwright/test": "1.64.1",
    "@types/react-dom": "19.3.0",
    "@moonbase/workspace": "workspace:*",
    "@stylexjs/stylex": "0.19.1",
    "effect": "4.1.0",
    "electron": "45.1.0",
    "@types/react": "19.3.0",
    "vite-plus": "1.4.0",
    "@types/node": "26.6.6",
    "react-dom": "19.3.1",
    "@base-ui/react": "1.9.0",
    "@vitejs/plugin-react": "6.1.2"
  },
  "trustedDependencies": [
    "electron",
    "esbuild",
    "nx"
  ]
}
