{
  "name": "@moonbase/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "test:desktop": "playwright test --project editor",
    "check:renderer": "node scripts/check-renderer.mjs",
    "test:package": "MOONBASE_PACKAGED_TEST=1 playwright test --project packaged --project reload --project composition",
    "test:native": "playwright test --project editor --project configuration --project reload --project composition --project recovery --project local",
    "test:composition": "playwright test --project composition",
    "test:reload": "playwright test --project reload",
    "check:package": "node scripts/check-package.mjs",
    "demo:browser": "vp dev --config vite.browser.config.ts --host 127.0.0.1",
    "test:browser": "playwright test --config playwright.browser.config.ts",
    "test:local": "playwright test --project local"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@moonbase/application": "workspace:*",
    "@moonbase/contracts": "workspace:*",
    "@moonbase/pi-runtime": "workspace:*",
    "@moonbase/ssh": "workspace:*",
    "@moonbase/ui": "workspace:*",
    "@moonbase/workbench": "workspace:*",
    "@moonbase/workspace": "workspace:*",
    "@stylexjs/stylex": "0.19.1",
    "diff": "8.0.4",
    "effect": "4.1.0",
    "mdast-util-from-markdown": "2.1.0",
    "monaco-editor": "0.57.0",
    "motion": "14.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@moonbase/effect": "workspace:*",
    "@types/mdast": "4.0.4",
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "nx": {
    "targets": {
      "dev": {
        "dependsOn": [
          "^build"
        ]
      },
      "build": {
        "dependsOn": [
          "^build"
        ]
      },
      "package": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
