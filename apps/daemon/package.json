{
  "name": "@moonbase/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/main.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "bun check --no-script -p tsconfig.json",
    "lint": "oxlint .",
    "test": "bun test --timeout 60000 --parallel=${MOONBASE_TEST_WORKERS:-4} ./test",
    "test:linux": "bun test --timeout 60000 --parallel=${MOONBASE_TEST_WORKERS:-4} --path-ignore-patterns='test/macos/**' ./test",
    "test:macos": "bun test --timeout 60000 --parallel=${MOONBASE_TEST_WORKERS:-4} ./test/macos"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@effect/platform-bun": "4.1.0",
    "@moonbase/application": "workspace:*",
    "@moonbase/chat-runtime": "workspace:*",
    "@moonbase/contracts": "workspace:*",
    "@moonbase/daemon-protocol": "workspace:*",
    "@moonbase/workspace": "workspace:*",
    "effect": "4.1.0"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "nx": {
    "tags": [
      "macos-tests"
    ],
    "targets": {
      "test": {
        "dependsOn": [
          {
            "projects": [
              "@moonbase/workspace"
            ],
            "target": "build"
          }
        ]
      },
      "test:macos": {
        "dependsOn": [
          {
            "projects": [
              "@moonbase/workspace"
            ],
            "target": "build"
          }
        ]
      }
    }
  }
}
