{
  "name": "@moonbase/chat-probe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "exports": {
    "./ui": "./src/ui.tsx",
    "./controller": "./src/controller.ts",
    "./bridge": "./src/wire.ts",
    "./native-session": "./src/session.ts",
    "./native-config": "./src/config.ts",
    "./test-fixture": "./test/fixture.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "test": "node --experimental-strip-types --test --test-concurrency=1 test/*.test.ts",
    "build": "node scripts/build.mjs",
    "start": "electron dist/main.mjs",
    "test:desktop": "playwright test --config playwright.config.ts",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@moonbase/application": "workspace:*",
    "@moonbase/pi-runtime": "workspace:*",
    "@moonbase/ssh": "workspace:*",
    "@moonbase/ui": "workspace:*",
    "@stylexjs/stylex": "0.19.1",
    "effect": "4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "typebox": "1.3.27"
  }
}
