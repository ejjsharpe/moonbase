{
  "name": "@moonbase/ssh",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./configuration": "./src/configuration.ts"
  },
  "scripts": {
    "build": "bun check --no-script -p tsconfig.json",
    "typecheck": "bun check --no-script -p tsconfig.json",
    "lint": "oxlint .",
    "test": "node --experimental-strip-types --test --test-concurrency=${MOONBASE_TEST_WORKERS:-4} test/*.test.ts test/macos/*.test.ts",
    "test:linux": "node --experimental-strip-types --test --test-concurrency=${MOONBASE_TEST_WORKERS:-4} test/*.test.ts",
    "test:macos": "node --experimental-strip-types --test --test-concurrency=${MOONBASE_TEST_WORKERS:-4} test/macos/*.test.ts"
  },
  "dependencies": {
    "effect": "4.1.0",
    "@moonbase/contracts": "workspace:*",
    "@moonbase/effect": "workspace:*"
  },
  "devDependencies": {
    "@moonbase/application": "workspace:*"
  },
  "nx": {
    "tags": [
      "macos-tests"
    ]
  }
}
