{
  "name": "@moonbase/config",
  "private": true,
  "type": "module",
  "exports": {
    "./oxlint": "./oxlint.mjs",
    "./oxfmt": "./oxfmt.json",
    "./typescript/base.json": "./typescript/base.json"
  },
  "scripts": {
    "test": "node --test '*.test.mjs'"
  },
  "nx": {
    "targets": {
      "test": {
        "inputs": [
          "default",
          "{workspaceRoot}/oxlint.config.mts",
          "{workspaceRoot}/oxfmt.config.mts",
          "{workspaceRoot}/scripts/**/*",
          "{workspaceRoot}/{packages,apps,tests}/**/*",
          {
            "externalDependencies": [
              "oxlint",
              "oxfmt",
              "esbuild",
              "effect",
              "@stylexjs/unplugin"
            ]
          }
        ]
      }
    }
  }
}
