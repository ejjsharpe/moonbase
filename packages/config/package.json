{
  "name": "@moonbase/config",
  "private": true,
  "type": "module",
  "exports": {
    "./oxlint": "./oxlint.mjs",
    "./oxfmt": "./oxfmt.json",
    "./typescript/base.json": "./typescript/base.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "nx": {
    "targets": {
      "test": {
        "inputs": [
          "default",
          "{workspaceRoot}/oxlint.config.mts",
          "{workspaceRoot}/oxfmt.config.mts",
          "{workspaceRoot}/scripts/check-foundation.mjs",
          "{workspaceRoot}/packages/application/src/**/*",
          "{workspaceRoot}/packages/application/package.json",
          "{workspaceRoot}/packages/chat/src/**/*",
          "{workspaceRoot}/packages/chat/package.json",
          "{workspaceRoot}/packages/editor/src/**/*",
          "{workspaceRoot}/packages/editor/package.json",
          {
            "externalDependencies": [
              "oxlint",
              "oxfmt",
              "esbuild",
              "effect"
            ]
          }
        ]
      }
    }
  }
}
