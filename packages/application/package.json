{
  "name": "@moonbase/application",
  "private": true,
  "type": "module",
  "exports": {
    "./chat/clients": "./src/chat/chat-clients.ts",
    "./chat/promises": "./src/chat/chat-promises.ts",
    "./chat": "./src/chat/index.ts",
    "./editor": "./src/editor/index.ts",
    "./testing/faux-workspace": "./src/testing/faux-workspace.ts",
    "./testing/faux-chat": "./src/testing/faux-chat.ts",
    "./testing/chat-fixture": "./src/testing/chat-fixture.ts",
    ".": "./src/index.ts",
    "./testing/editor-fixture": "./src/testing/editor-fixture.ts"
  },
  "scripts": {
    "typecheck": "bun check --no-script -p tsconfig.json",
    "lint": "oxlint .",
    "test": "node --test --test-concurrency=${MOONBASE_TEST_WORKERS:-4} \"test/**/*.test.ts\""
  },
  "dependencies": {
    "effect": "4.1.0",
    "@moonbase/contracts": "workspace:*",
    "@moonbase/effect": "workspace:*",
    "lru-cache": "11.5.3"
  },
  "devDependencies": {
    "@moonbase/config": "workspace:*"
  },
  "nx": {
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^default"
        ]
      }
    }
  }
}
