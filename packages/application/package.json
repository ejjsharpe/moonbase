{
  "name": "@moonbase/application",
  "private": true,
  "type": "module",
  "exports": {
    "./runtime/handlers": "./src/runtime/handlers.ts",
    "./runtime/clients": "./src/runtime/clients.ts",
    "./runtime/effect-client": "./src/runtime/effect-client.ts",
    "./chat": "./src/chat/index.ts",
    "./editor": "./src/editor/index.ts",
    "./testing/memory-workspace": "./src/testing/memory-workspace.ts",
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "test": "node --experimental-strip-types --test --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "effect": "4.1.0",
    "@moonbase/contracts": "workspace:*",
    "@moonbase/effect": "workspace:*",
    "lru-cache": "11.5.3"
  },
  "devDependencies": {
    "@moonbase/config": "workspace:*",
    "@moonbase/ssh": "workspace:*"
  },
  "nx": {
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/tests/chat/**/*",
          {
            "input": "default",
            "projects": [
              "@moonbase/chat-runtime",
              "@moonbase/daemon-protocol",
              "@moonbase/ssh"
            ]
          }
        ]
      }
    }
  }
}
