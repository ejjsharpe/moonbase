{
  "name": "@moonbase/application",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./services": "./src/services.ts",
    "./handlers": "./src/handlers.ts",
    "./runtime-client": "./src/runtime-client.ts",
    "./host-client": "./src/host-client.ts",
    "./host-health": "./src/host-health.ts",
    "./connection-client": "./src/connection-client.ts",
    "./chat-client": "./src/chat-client.ts",
    "./chat-schema": "./src/chat-schema.ts",
    "./workspace-schema": "./src/workspace-schema.ts",
    "./connection-schema": "./src/connection-schema.ts",
    "./host-schema": "./src/host-schema.ts",
    "./error-schema": "./src/error-schema.ts",
    "./effect-client": "./src/effect-client.ts",
    "./runtime/handlers": "./src/runtime/handlers.ts",
    "./runtime/clients": "./src/runtime/clients.ts",
    "./runtime/effect-client": "./src/runtime/effect-client.ts",
    "./chat": "./src/features/chat/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "test": "node --experimental-strip-types --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "effect": "4.1.0",
    "@moonbase/contracts": "workspace:*",
    "@moonbase/effect": "workspace:*"
  },
  "devDependencies": {
    "@moonbase/config": "workspace:*",
    "@moonbase/ssh": "workspace:*"
  },
  "nx": {
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/tests/chat/**/*",
          {
            "input": "default",
            "projects": [
              "@moonbase/pi-runtime",
              "@moonbase/ssh"
            ]
          }
        ]
      }
    }
  }
}
