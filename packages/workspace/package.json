{
  "name": "@moonbase/workspace",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./filesystem": "./dist/filesystem"
  },
  "scripts": {
    "build": "node scripts/build-native.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "test": "node scripts/build-native.mjs && bun test --timeout 60000 --parallel=${MOONBASE_TEST_WORKERS:-4} ./test",
    "test:macos": "bun run test"
  },
  "dependencies": {
    "effect": "4.1.0",
    "@moonbase/contracts": "workspace:*",
    "@moonbase/effect": "workspace:*"
  },
  "devDependencies": {
    "@moonbase/application": "workspace:*"
  },
  "nx": {
    "tags": [
      "macos-tests"
    ]
  }
}
